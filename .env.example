# Скопируй в .env и заполни. Имена как в Vercel (префикс TGSTN_).

TGSTN_POSTGRES_PRISMA_URL=
TGSTN_POSTGRES_URL_NON_POOLING=

TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=
# bot | hybrid | user (по умолчанию hybrid, если TELEGRAM_BOT_TOKEN задан)
TELEGRAM_DELIVERY_MODE=hybrid
# После установки токена пользователи должны нажать /start у бота
# Опционально для npm run auth (иначе спросит в терминале)
TELEGRAM_AUTH_PHONE=
ADMIN_USERNAME=

DEEPL_API_KEY=
OPENAI_API_KEY=
